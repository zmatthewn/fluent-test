    "/fluent_getShippingLabel/:filename": {
      "x-zuplo-path": {
        "pathMode": "url-pattern"
      },
      "get": {
        "summary": "proship:fluent",
        "description": "url rewrite to serve shipping label from object storage",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "${env.AZURE_BLOB_BASEURL}/applications/proship/labels/${params.filename}?${env.AZURE_BLOB_SAS_AUTH}"
            }
          },
          "policies": {
            "inbound": [
              "api-logging-inbound"
            ],
            "outbound": [
              "fluent-set-headers-outbound-image",
              "api-logging-outbound"
            ]
          }
        },
        "operationId": "new-route-80f5dc5b",
        "additionalOperationContext": {
          "oasFilePath": "/config/routes.oas.json",
          "method": "get",
          "path": "/fluent_getShippingLabel/:filename",
          "pathZuploConfig": {
            "pathMode": "url-pattern"
          }
        }
