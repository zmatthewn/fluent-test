{
  "policies": [
    {
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "Authorization",
              "value": "$env(BOOMI_EVENT_STREAMS_TOKEN)"
            }
          ]
        }
      },
      "name": "boomi-event-streams-bearer-token-inbound",
      "policyType": "set-headers-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/fluent-signature-verify-hmac-auth-inbound)"
      },
      "name": "fluent-signature-verify-hmac-auth-inbound",
      "policyType": "custom-code-inbound"
    },
    {
      "handler": {
        "export": "BasicAuthInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "accounts": [
            {
              "data": {
                "name": "John Doe",
                "email": "john.doe@gmail.com"
              },
              "password": "$env(CROWDTWIST_FLUENT_PASSWORD)",
              "username": "$env(CROWDTWIST_FLUENT_USERNAME)"
            }
          ],
          "allowUnauthenticatedRequests": false
        }
      },
      "name": "crowdtwist-fluent-basic-auth-inbound",
      "policyType": "basic-auth-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "Authorization",
              "value": "$env(TEMPUATPROD_BOOMI_EVENT_STREAMS_TOKEN)"
            }
          ]
        }
      },
      "name": "tempuatprod-boomi-event-streams-bearer-token",
      "policyType": "set-headers-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "Content-Type",
              "value": "image/png"
            },
            {
              "name": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "name": "Content-Disposition",
              "value": "inline"
            }
          ]
        }
      },
      "name": "fluent-set-headers-outbound-image",
      "policyType": "set-headers-outbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/api-logging-outbound)",
        "options": {
          "blobBaseUrl": "$env(AZURE_BLOB_BASEURL)",
          "sasAuth": "$env(AZURE_BLOB_SAS_AUTH)",
          "debugEnabled": "$env(API_LOGGING_DEBUG_ENABLED)"
        }
      },
      "name": "api-logging-outbound",
      "policyType": "custom-code-outbound"
    }
  ]
}